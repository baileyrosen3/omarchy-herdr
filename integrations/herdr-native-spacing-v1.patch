+    #[test]
+    fn zero_gap_axes_keep_padding_other_gaps_and_shared_focus() {
+        let mut workspace = Workspace::test_new("test");
+        let root = workspace.tabs[0].root_pane;
+        let right = workspace.test_split(ratatui::layout::Direction::Horizontal);
+        workspace.tabs[0].layout.focus_pane(root);
+        let below = workspace.test_split(ratatui::layout::Direction::Vertical);
+        workspace.tabs[0].layout.focus_pane(root);
+        let area = Rect::new(0, 0, 100, 20);
+        let splits = workspace.tabs[0].layout.splits(area);
+        let mut app = AppState::test_new();
+        app.pane_borders = PaneBordersConfig::Auto;
+        app.pane_gaps = true;
+        app.view.terminal_area = area;
+        let mut terminal =
+            ratatui::Terminal::new(ratatui::backend::TestBackend::new(100, 20)).unwrap();
+
+        for horizontal in [true, false] {
+            app.pane_spacing = crate::config::PaneSpacing {
+                gap_horizontal: if horizontal { 0 } else { 3 },
+                gap_vertical: if horizontal { 5 } else { 0 },
+                padding_horizontal: 2,
+                padding_vertical: 1,
+            };
+            app.view.pane_infos = apply_pane_chrome(
+                workspace.tabs[0].layout.panes(area),
+                app.pane_borders,
+                true,
+                app.pane_spacing,
+                true,
+            );
+            let top_left = app
+                .view
+                .pane_infos
+                .iter()
+                .find(|info| info.id == root)
+                .unwrap();
+            let bottom_left = app
+                .view
+                .pane_infos
+                .iter()
+                .find(|info| info.id == below)
+                .unwrap();
+            let right_pane = app
+                .view
+                .pane_infos
+                .iter()
+                .find(|info| info.id == right)
+                .unwrap();
+            assert_eq!(
+                right_pane.rect.x - top_left.rect.right(),
+                app.pane_spacing.gap_horizontal
+            );
+            assert_eq!(
+                bottom_left.rect.y - top_left.rect.bottom(),
+                app.pane_spacing.gap_vertical
+            );
+            assert_eq!(top_left.rect.x, 2);
+            assert_eq!(top_left.rect.y, 1);
+            assert_eq!(area.right() - right_pane.rect.right(), 2);
+            assert_eq!(area.bottom() - bottom_left.rect.bottom(), 1);
+            assert_eq!(top_left.borders.contains(Borders::RIGHT), !horizontal);
+            assert_eq!(top_left.borders.contains(Borders::BOTTOM), horizontal);
+            terminal
+                .draw(|frame| render_view_pane_borders(&app, &workspace, &splits, frame))
+                .unwrap();
+            let buffer = terminal.backend().buffer();
+            for x in 0..100 {
+                assert_eq!(buffer[(x, 0)].symbol(), " ");
+                assert_eq!(buffer[(x, 19)].symbol(), " ");
+            }
+            if horizontal {
+                assert_eq!(buffer[(50, 1)].symbol(), "┬");
+                assert_eq!(buffer[(50, 2)].fg, app.palette.accent);
+            } else {
+                assert_eq!(buffer[(3, 10)].fg, app.palette.accent);
+            }
+        }
+    }
