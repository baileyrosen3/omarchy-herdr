+    fn oversized_pane_spacing_clamps_inside_the_original_area() {
+        let mut workspace = Workspace::test_new("test");
+        workspace.test_split(ratatui::layout::Direction::Horizontal);
+        let area = Rect::new(0, 0, 7, 4);
+        let oversized = crate::config::PaneSpacing {
+            gap_horizontal: u16::MAX,
+            gap_vertical: u16::MAX,
+            padding_horizontal: u16::MAX,
+            padding_vertical: u16::MAX,
+        };
+
+        let infos = apply_pane_chrome(
+            workspace.tabs[0].layout.panes(area),
+            PaneBordersConfig::Auto,
+            true,
+            oversized,
+            true,
+        );
+
+        assert_eq!(infos.len(), 2);
+        for info in &infos {
+            let pane_right = u32::from(info.rect.x) + u32::from(info.rect.width);
+            let pane_bottom = u32::from(info.rect.y) + u32::from(info.rect.height);
+            let area_right = u32::from(area.x) + u32::from(area.width);
+            let area_bottom = u32::from(area.y) + u32::from(area.height);
+            assert!(info.rect.x >= area.x);
+            assert!(info.rect.y >= area.y);
+            assert!(pane_right <= area_right);
+            assert!(pane_bottom <= area_bottom);
+        }
+    }
