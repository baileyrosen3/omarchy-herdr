+                    );
+                    let compact_geometry: Vec<_> = app
+                        .view
+                        .pane_infos
+                        .iter()
+                        .map(|info| (info.rect, info.borders))
+                        .collect();
+                    terminal
+                        .draw(|frame| render_view_pane_borders(&app, &workspace, &splits, frame))
+                        .unwrap();
+                    assert_eq!(zero_geometry, compact_geometry);
+                    assert_eq!(&zero_buffer, terminal.backend().buffer());
+                }
+            }
+        }
