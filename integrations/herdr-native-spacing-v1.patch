+/// Resolved copyable pane spacing geometry, derived from [`UiConfig`] so layout,
+/// render, hit-test, and background sizing paths never re-read configuration.
+///
+/// The values only take effect while `ui.pane_gaps` is enabled; disabled keeps
+/// the compact shared-border geometry and ignores these sizes.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PaneSpacing {
+    /// Blank terminal columns between side-by-side pane areas.
+    pub gap_horizontal: u16,
+    /// Blank terminal rows between stacked pane areas.
+    pub gap_vertical: u16,
+    /// Blank terminal columns at the left and right edges of the tab pane area.
+    pub padding_horizontal: u16,
+    /// Blank terminal rows at the top and bottom edges of the tab pane area.
+    pub padding_vertical: u16,
+}
+
+impl Default for PaneSpacing {
+    fn default() -> Self {
+        Self {
+            gap_horizontal: 2,
+            gap_vertical: 1,
+            padding_horizontal: 1,
+            padding_vertical: 1,
+        }
+    }
+}
+
+#[cfg(test)]
+mod pane_spacing_default_tests {
+    use super::{Config, PaneSpacing};
+
+    #[test]
+    fn pane_spacing_defaults_preserve_compact_split_room() {
+        let expected = PaneSpacing {
+            gap_horizontal: 2,
+            gap_vertical: 1,
+            padding_horizontal: 1,
+            padding_vertical: 1,
+        };
+        assert_eq!(PaneSpacing::default(), expected);
+        assert_eq!(Config::default().ui.pane_spacing(), expected);
+        let inherited: Config = toml::from_str("[ui]").unwrap();
+        assert_eq!(inherited.ui.pane_spacing(), expected);
+    }
+}
+
