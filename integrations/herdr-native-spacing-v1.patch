+        let bottom_left = workspace.test_split(ratatui::layout::Direction::Vertical);
+        let spacing = test_spacing();
+
+        let infos = apply_pane_chrome(
+            workspace.tabs[0].layout.panes(Rect::new(0, 0, 40, 20)),
+            PaneBordersConfig::Auto,
+            true,
+            spacing,
+            true,
+        );
+        let top_left = infos.iter().find(|info| info.id == root).unwrap();
+        let bottom_left = infos.iter().find(|info| info.id == bottom_left).unwrap();
+        let right = infos.iter().find(|info| info.id == right).unwrap();
+
+        assert_eq!(top_left.rect, Rect::new(2, 1, 15, 4));
+        assert_eq!(bottom_left.rect, Rect::new(2, 10, 15, 9));
+        assert_eq!(right.rect, Rect::new(20, 1, 18, 18));
+        // Both left-hand bands keep the same blank columns before the right pane.
+        let top_gap = right.rect.x - (top_left.rect.x + top_left.rect.width);
+        let bottom_gap = right.rect.x - (bottom_left.rect.x + bottom_left.rect.width);
+        assert_eq!(top_gap, spacing.gap_horizontal);
+        assert_eq!(bottom_gap, spacing.gap_horizontal);
+        let vertical_gap = bottom_left.rect.y - (top_left.rect.y + top_left.rect.height);
+        assert_eq!(vertical_gap, spacing.gap_vertical);
+    }
