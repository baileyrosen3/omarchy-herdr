+impl super::ClientShellState {
+    pub(super) fn footer_commands_current(&self, area: super::Rect) -> bool {
+        if area.is_empty()
+            || !self.active_endpoint_id.is_local()
+            || self.endpoint_status(&self.active_endpoint_id)
+                != Some(super::ClientEndpointStatus::Online)
+        {
+            return false;
+        }
+        let Some(context) = self.footer.context.as_ref() else {
+            return false;
+        };
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return false;
+        };
+        context.local
+            && context.width == area.width
+            && context.boot_id == snapshot.boot_id
+            && context.workspace_id == snapshot.focused_workspace_id
+            && context.tab_id == snapshot.focused_tab_id
+            && context.pane_id == snapshot.focused_pane_id
+    }
+
+    pub(crate) fn tick_footer(&mut self, now: Instant, cols: u16, rows: u16) -> bool {
+        if !self.footer.has_commands() {
+            return false;
+        }
+        let area = self.layout(cols, rows).footer;
+        let snapshot = self.snapshot.as_deref();
+        self.footer.tick(
+            now,
+            FooterContext {
+                width: if area.is_empty() { 0 } else { area.width },
+                local: self.active_endpoint_id.is_local()
+                    && self.endpoint_status(&self.active_endpoint_id)
+                        == Some(super::ClientEndpointStatus::Online)
+                    && crate::server::socket_paths::derive_client_socket_from_api_socket(
+                        &crate::api::socket_path(),
+                    ) == crate::server::socket_paths::client_socket_path(),
+                boot_id: snapshot.map(|s| s.boot_id.clone()).unwrap_or_default(),
+                workspace_id: snapshot.and_then(|s| s.focused_workspace_id.clone()),
+                tab_id: snapshot.and_then(|s| s.focused_tab_id.clone()),
+                pane_id: snapshot.and_then(|s| s.focused_pane_id.clone()),
+            },
+        )
+    }
+}
