+    assert_eq!(footer.footer, Rect::new(0, 23, 120, 1));
+    assert_eq!(footer.tab_bar, normal.tab_bar);
+    assert_eq!(footer.pane_surface.height, normal.pane_surface.height - 1);
+    assert_eq!(footer.sidebar.height, normal.sidebar.height - 1);
+    assert_eq!(footer.pane_surface.bottom(), footer.footer.y);
+}
+#[test]
+fn footer_survives_single_tab_hiding_and_stays_outside_bottom_tabs() {
+    let mut config = config_with_footer();
+    config.hide_tab_bar_when_single_tab = true;
+    let layout = config.layout(120, 24, false, 1, 26);
+    assert!(layout.tab_bar.is_empty());
+    assert_eq!(layout.footer.height, 1);
+    config.hide_tab_bar_when_single_tab = false;
+    config.tab_bar_position = TabBarPositionConfig::Bottom;
+    let layout = config.layout(120, 24, false, 2, 26);
+    assert_eq!(layout.tab_bar.bottom(), layout.footer.y);
+    assert_eq!(layout.pane_surface.bottom(), layout.tab_bar.y);
+}
+#[test]
+fn footer_geometry_is_bounded_in_mobile_and_tiny_windows() {
+    let config = config_with_footer();
+    for cols in [0, 1, 40, 120] {
+        for rows in 0..6 {
+            let layout = config.layout(cols, rows, false, 2, 26);
+            assert!(layout.footer.bottom() <= rows);
+            assert!(layout.pane_surface.bottom() <= rows);
+            assert!(layout.sidebar.bottom() <= layout.footer.y);
+            assert!(layout.footer.height <= 1);
+            if rows <= 1 {
+                assert!(layout.footer.is_empty());
+            }
+        }
+    }
+    let layout = config.layout(40, 10, false, 2, 26);
+    assert_eq!(layout.footer, Rect::new(0, 9, 40, 1));
+    assert_eq!(layout.mobile_header.height, 2);
+    assert_eq!(layout.pane_surface.height, 7);
+}
+#[test]
+fn normal_footer_is_themed_has_no_hits_and_never_becomes_a_pane() {
+    let mut state = ClientShellState::new(config_with_footer());
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    let frame = state.compose(120, 24).unwrap();
+    assert!(frame_rows(&frame)[23].starts_with("Super+Alt M Menu"));
+    let layout = state.layout(120, 24);
+    assert_eq!(state.snapshot.as_ref().unwrap().panes.len(), 1);
+    assert_eq!(state.hits.panes.len(), 1);
+    assert!(state
+        .hits
+        .panes
+        .iter()
+        .all(|p| p.rect.bottom() <= layout.footer.y));
+    for column in [0, 26, 80, 119] {
+        let output = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column,
+            row: 23,
+            modifiers: KeyModifiers::empty(),
+        })]);
+        assert!(output.actions.is_empty());
+        assert!(output.requests.is_empty());
+    }
+    assert_eq!(
+        frame.cells[23 * 120].bg,
+        crate::protocol::color_to_u32(state.config.palette.panel_bg)
+    );
+}
+#[test]
+fn footer_reserves_same_row_while_command_has_no_output() {
+    let mut config = config_with_footer();
+    config.footer = vec![FooterEntryConfig::Command {
+        command: "helper".into(),
+        interval_seconds: 5,
+        timeout_seconds: 2,
+    }];
+    let mut state = ClientShellState::new(config);
+    let before = state.surface_size(120, 24);
+    state.footer.configure(&state.config.footer);
+    assert_eq!(state.surface_size(120, 24), before);
+}
+
+#[test]
+fn mode_bars_and_mobile_switcher_do_not_overwrite_footer() {
+    for width in [44, 120] {
+        for mode in [
+            ClientShellMode::Prefix,
+            ClientShellMode::Navigate,
+            ClientShellMode::Copy,
+            ClientShellMode::Resize,
+        ] {
+            let mut state = ClientShellState::new(config_with_footer());
+            state.set_snapshot(Box::new(snapshot()));
+            state.set_pane_surface(surface());
+            state.mode = mode;
+            let frame = state.compose(width, 24).unwrap();
+            assert!(
+                frame_rows(&frame)[23].starts_with("Super+Alt M Menu"),
+                "footer obscured at {width} columns in {mode:?}"
+            );
+        }
+    }
+}
+#[test]
+fn bottom_notification_is_above_footer_in_both_layouts() {
+    for width in [44, 120] {
+        let mut state = ClientShellState::new(config_with_footer());
+        state.set_snapshot(Box::new(snapshot()));
+        state.set_pane_surface(surface());
+        state.visible_notification = Some(ClientVisibleNotification {
+            endpoint_id: ClientEndpointId::Local,
+            event: SemanticNotification {
+                kind: SemanticNotificationKind::Custom,
+                title: "notification".into(),
+                body: None,
+                sound: None,
+                agent: None,
+                workspace_id: None,
+                tab_id: None,
+                pane_id: None,
+                position: Some(crate::config::ToastHerdrPosition::BottomRight),
+            },
+            deadline: std::time::Instant::now() + std::time::Duration::from_secs(10),
+        });
+        let frame = state.compose(width, 24).unwrap();
+        assert!(frame_rows(&frame)[23].starts_with("Super+Alt M Menu"));
+        assert!(state.hits.notification_toast.bottom() <= 23);
+    }
+}
+#[test]
+fn empty_footer_preserves_existing_desktop_and_mobile_layouts() {
+    let config = ClientShellConfig::from_config(&Config::default());
+    let desktop = config.layout(120, 24, false, 2, 26);
+    assert!(desktop.footer.is_empty());
+    assert_eq!(desktop.sidebar, Rect::new(0, 0, 26, 24));
+    assert_eq!(desktop.tab_bar, Rect::new(26, 0, 94, 1));
+    assert_eq!(desktop.pane_surface, Rect::new(26, 1, 94, 23));
+    let mobile = config.layout(40, 1, false, 2, 26);
+    assert_eq!(mobile.mobile_header, Rect::new(0, 0, 40, 1));
+    assert!(mobile.footer.is_empty());
+}
