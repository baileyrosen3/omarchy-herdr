new file mode 100644
index 0000000..10a4477
--- /dev/null
+++ b/src/client/shell/footer.rs
@@ -0,0 +1,821 @@
+//! Client-local footer. Runtime work happens on timer ticks, never in render.
+//! Commands execute only while a connected Local endpoint is selected.
+use crate::config::{FooterEntryConfig, MAX_FOOTER_ENTRIES};
+use std::{
+    process::Stdio,
+    sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc, Mutex,
+    },
+    time::{Duration, Instant},
+};
+use tokio::io::AsyncReadExt;
+
+const MAX_COMMAND_LINE_BYTES: usize = 4096;
+const MAX_TEXT_CHARS: usize = 4096;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct FooterContext {
+    pub width: u16,
+    pub local: bool,
+    pub boot_id: String,
+    pub workspace_id: Option<String>,
+    pub tab_id: Option<String>,
+    pub pane_id: Option<String>,
+}
+
+#[derive(Debug)]
+struct Completion {
+    generation: u64,
+    index: usize,
+    output: Result<Option<String>, String>,
+}
+
+struct CommandTask {
+    abort: tokio::task::AbortHandle,
+    control: Arc<StatusCommandControl>,
+}
+impl Drop for CommandTask {
+    fn drop(&mut self) {
+        self.control.terminate();
+        self.abort.abort();
+    }
+}
+
+struct Entry {
+    config: FooterEntryConfig,
+    text: Option<String>,
+    next_run: Instant,
+    task: Option<CommandTask>,
+}
+
+pub(super) struct FooterRuntime {
+    config: Vec<FooterEntryConfig>,
+    entries: Vec<Entry>,
+    generation: u64,
+    context: Option<FooterContext>,
+    tx: mpsc::SyncSender<Completion>,
+    rx: mpsc::Receiver<Completion>,
+}
+
+impl FooterRuntime {
+    pub(super) fn new(config: &[FooterEntryConfig]) -> Self {
+        let (tx, rx) = mpsc::sync_channel(MAX_FOOTER_ENTRIES);
+        let mut runtime = Self {
+            config: Vec::new(),
+            entries: Vec::new(),
+            generation: 0,
+            context: None,
+            tx,
+            rx,
+        };
+        runtime.configure(config);
+        runtime
+    }
+
+    pub(super) fn configure(&mut self, config: &[FooterEntryConfig]) {
+        if self.config == config {
+            return;
+        }
+        self.entries.clear(); // Synchronously terminate groups before releasing tasks.
+        self.generation = self.generation.wrapping_add(1);
+        self.context = None;
+        self.config = config.to_vec();
+        let (tx, rx) = mpsc::sync_channel(MAX_FOOTER_ENTRIES);
+        self.tx = tx;
+        self.rx = rx;
+        let now = Instant::now();
+        for entry in config.iter().take(MAX_FOOTER_ENTRIES) {
+            let text = match entry {
+                FooterEntryConfig::Text { text } => sanitize_status_text(text),
+                FooterEntryConfig::Command {
+                    command,
+                    interval_seconds,
+                    timeout_seconds,
+                } if !command.trim().is_empty()
+                    && (1..=31_536_000).contains(interval_seconds)
+                    && (1..=3_600).contains(timeout_seconds)
+                    && crate::platform::status_commands_supported() =>
+                {
+                    None
+                }
+                FooterEntryConfig::Command { .. } => continue,
+            };
+            self.entries.push(Entry {
+                config: entry.clone(),
+                text,
+                next_run: now,
+                task: None,
+            });
+        }
+    }
+
+    pub(super) fn tick(&mut self, now: Instant, context: FooterContext) -> bool {
+        if self.entries.is_empty() {
+            return false;
+        }
+        let mut changed = false;
+        if self.context.as_ref() != Some(&context) {
+            self.generation = self.generation.wrapping_add(1);
+            for entry in &mut self.entries {
+                if matches!(entry.config, FooterEntryConfig::Command { .. }) {
+                    entry.task = None;
+                    changed |= entry.text.take().is_some();
+                    entry.next_run = now;
+                }
+            }
+            self.context = Some(context.clone());
+        }
+        for completed in self.rx.try_iter() {
+            if completed.generation != self.generation {
+                continue;
+            }
+            let Some(entry) = self.entries.get_mut(completed.index) else {
+                continue;
+            };
+            entry.task = None;
+            let output = completed.output.unwrap_or_else(|error| {
+                tracing::debug!(%error, "client footer command failed");
+                None
+            });
+            changed |= entry.text != output;
+            entry.text = output;
+        }
+        if !context.local || context.width == 0 {
+            return changed;
+        }
+        let Ok(handle) = tokio::runtime::Handle::try_current() else {
+            return changed;
+        };
+        for (index, entry) in self.entries.iter_mut().enumerate() {
+            let FooterEntryConfig::Command {
+                command,
+                interval_seconds,
+                timeout_seconds,
+            } = &entry.config
+            else {
+                continue;
+            };
+            // A completed task whose bounded result was dropped must not stall
+            // its entry forever (for example after many rapid context changes).
+            if entry
+                .task
+                .as_ref()
+                .is_some_and(|task| task.abort.is_finished())
+            {
+                entry.task = None;
+            }
+            if entry.task.is_some() || now < entry.next_run {
+                continue;
+            }
+            entry.next_run = now
+                .checked_add(Duration::from_secs(*interval_seconds))
+                .unwrap_or(now);
+            let tx = self.tx.clone();
+            let generation = self.generation;
+            let command = command.clone();
+            let timeout = Duration::from_secs(*timeout_seconds);
+            let deadline = tokio::time::Instant::now() + timeout;
+            let environment = context.environment();
+            let control = Arc::new(StatusCommandControl {
+                terminated: AtomicBool::new(false),
+                process_group: Mutex::new(None),
+            });
+            let task_control = Arc::clone(&control);
+            let task = handle.spawn(async move {
+                let output = run_status_command(
+                    &task_control,
+                    command,
+                    timeout,
+                    deadline,
+                    environment,
+                    None,
+                )
+                .await;
+                task_control.terminate();
+                // At most one result per bounded entry. Never block terminal input.
+                let _ = tx.try_send(Completion {
+                    generation,
+                    index,
+                    output,
+                });
+            });
+            entry.task = Some(CommandTask {
+                abort: task.abort_handle(),
+                control,
+            });
+        }
+        changed
+    }
+
+    fn has_commands(&self) -> bool {
+        self.entries
+            .iter()
+            .any(|entry| matches!(entry.config, FooterEntryConfig::Command { .. }))
+    }
+
+    fn visible_texts(&self, commands_current: bool) -> impl Iterator<Item = &str> {
+        self.entries.iter().filter_map(move |entry| {
+            if !commands_current && matches!(entry.config, FooterEntryConfig::Command { .. }) {
+                None
+            } else {
+                entry.text.as_deref()
+            }
+        })
+    }
+
+    #[cfg(test)]
+    fn texts(&self) -> impl Iterator<Item = &str> {
+        self.visible_texts(true)
+    }
+}
+
+impl FooterContext {
+    fn environment(&self) -> Vec<(String, String)> {
+        let mut environment = vec![
+            ("HERDR_FOOTER_WIDTH".into(), self.width.to_string()),
+            ("HERDR_FOOTER_ENDPOINT".into(), "local".into()),
+            ("HERDR_FOOTER_LOCAL".into(), "1".into()),
+            (
+                crate::config::CONFIG_PATH_ENV_VAR.into(),
+                crate::config::config_path().display().to_string(),
+            ),
+            (
+                crate::api::SOCKET_PATH_ENV_VAR.into(),
+                crate::api::socket_path().display().to_string(),
+            ),
+        ];
+        if let Ok(binary) = std::env::current_exe() {
+            environment.push(("HERDR_BIN_PATH".into(), binary.display().to_string()));
+        }
+        for (name, value) in [
+            ("HERDR_ACTIVE_WORKSPACE_ID", &self.workspace_id),
+            ("HERDR_ACTIVE_TAB_ID", &self.tab_id),
+            ("HERDR_ACTIVE_PANE_ID", &self.pane_id),
+        ] {
+            if let Some(value) = value {
+                environment.push((name.into(), value.clone()));
+            }
+        }
+        environment
+    }
+}
