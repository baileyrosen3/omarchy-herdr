diff --git a/src/config/footer.rs b/src/config/footer.rs
new file mode 100644
index 0000000..986f2b5
--- /dev/null
+++ b/src/config/footer.rs
@@ -0,0 +1,85 @@
+use serde::{Deserialize, Serialize};
+
+pub(crate) const MAX_FOOTER_ENTRIES: usize = 16;
+
+fn default_interval() -> u64 {
+    5
+}
+fn default_timeout() -> u64 {
+    2
+}
+
+/// Client-local presentation entries; these never enter an endpoint codec.
+#[derive(Debug, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum FooterEntryConfig {
+    Text {
+        text: String,
+    },
+    Command {
+        command: String,
+        #[serde(default = "default_interval")]
+        interval_seconds: u64,
+        #[serde(default = "default_timeout")]
+        timeout_seconds: u64,
+    },
+}
+
+pub(crate) fn footer_diagnostics(entries: &[FooterEntryConfig]) -> Vec<String> {
+    let mut diagnostics = Vec::new();
+    if entries.len() > MAX_FOOTER_ENTRIES {
+        diagnostics.push(format!(
+            "ui.footer may contain at most {MAX_FOOTER_ENTRIES} entries; ignoring extras"
+        ));
+    }
+    for (index, entry) in entries.iter().enumerate().take(MAX_FOOTER_ENTRIES) {
+        if let FooterEntryConfig::Command {
+            command,
+            interval_seconds,
+            timeout_seconds,
+        } = entry
+        {
+            if command.trim().is_empty()
+                || !(1..=31_536_000).contains(interval_seconds)
+                || !(1..=3_600).contains(timeout_seconds)
+            {
+                diagnostics.push(format!("ui.footer[{index}] command requires nonempty text, interval_seconds 1–31536000, timeout_seconds 1–3600; hiding entry"));
+            }
+        }
+    }
+    diagnostics
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn parse_footer_defaults_and_reject_unknown_fields() {
+        let config: crate::config::Config = toml::from_str(
+            "[ui]\nfooter = [{type='command', command='helper'}, {type='text',text='Hints'}]",
+        )
+        .unwrap();
+        assert!(matches!(
+            config.ui.footer[0],
+            FooterEntryConfig::Command {
+                interval_seconds: 5,
+                timeout_seconds: 2,
+                ..
+            }
+        ));
+        assert!(toml::from_str::<crate::config::Config>(
+            "[ui]\nfooter = [{type='text',text='Hints',anchor='bottom'}]"
+        )
+        .is_err());
+        assert!(crate::config::Config::default().ui.footer.is_empty());
+    }
+    #[test]
+    fn invalid_footer_commands_report_without_mutating_configuration() {
+        let entries = vec![FooterEntryConfig::Command {
+            command: "".into(),
+            interval_seconds: 0,
+            timeout_seconds: 4_000,
+        }];
+        assert_eq!(footer_diagnostics(&entries).len(), 1);
+    }
+}
