+pub(super) fn render_footer(
+    buffer: &mut super::Buffer,
+    area: super::Rect,
+    runtime: &FooterRuntime,
+    separator: &str,
+    palette: &super::Palette,
+    commands_current: bool,
+) {
+    if area.is_empty() {
+        return;
+    }
+    let style = super::Style::default()
+        .fg(palette.overlay1)
+        .bg(palette.panel_bg);
+    buffer.set_style(area, style);
+    let mut x = area.x;
+    for (index, text) in runtime.visible_texts(commands_current).enumerate() {
+        if index > 0 {
+            super::render::put_text(
+                buffer,
+                x,
+                area.y,
+                area.right().saturating_sub(x),
+                separator,
+                style,
+            );
+            x = x
+                .saturating_add(super::render::display_width(separator))
+                .min(area.right());
+        }
+        if x >= area.right() {
+            break;
+        }
+        super::render::put_text(
+            buffer,
+            x,
+            area.y,
+            area.right().saturating_sub(x),
+            text,
+            style,
+        );
+        x = x
+            .saturating_add(super::render::display_width(text))
+            .min(area.right());
+    }
+}
